# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (For Day 4)
# Local: mongodb://localhost:27017/crisisai
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/crisisai?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/crisisai

# Authentication (For Day 5-6)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Gemini AI (For Day 7-8)
GEMINI_API_KEY=your_gemini_api_key_here
